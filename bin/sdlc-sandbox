#!/usr/bin/env python3
"""Build a throwaway product repository for trying the sdlc commands.

    sdlc-sandbox <dir> [--scenario <name>]
    sdlc-sandbox mutate <dir> <step> [args]

The repository holds a tiny app with tests, is set up with `specs init`, and pushes to a local
bare repository next to it (`<dir>.origin.git`), so nothing ever leaves the machine. A scenario
then puts specs in a scripted state; see sandbox/scenarios/<name>/README.md.
"""

import argparse
import os
import runpy
import shutil
import subprocess
import sys
from pathlib import Path

PLUGIN = Path(__file__).resolve().parent.parent
HELPER = PLUGIN / "tools" / "specs" / "specs"
APP = PLUGIN / "sandbox" / "app"
SCENARIOS = PLUGIN / "sandbox" / "scenarios"
DATE = "2026-09-23"
# A user's global git config (signing, hooks, templates) must not leak into a sandbox.
GIT_ENV = {
    **os.environ,
    "GIT_CONFIG_GLOBAL": os.devnull,
    "GIT_CONFIG_NOSYSTEM": "1",
    "GIT_AUTHOR_NAME": "Sandbox",
    "GIT_AUTHOR_EMAIL": "sandbox@example.com",
    "GIT_COMMITTER_NAME": "Sandbox",
    "GIT_COMMITTER_EMAIL": "sandbox@example.com",
}


class SandboxError(Exception):
    pass


class Sandbox:
    """What scenario scripts use to put the repository in a state."""

    def __init__(self, root: Path):
        self.root = root

    def git(self, *args: str) -> str:
        result = subprocess.run(
            ["git", "-C", str(self.root), *args], env=GIT_ENV, capture_output=True, text=True
        )
        if result.returncode != 0:
            raise SandboxError(f"git {' '.join(args)}: {result.stderr.strip()}")
        return result.stdout

    def specs(self, *args: str) -> str:
        result = subprocess.run(
            [sys.executable, str(HELPER), *args], cwd=self.root, env=GIT_ENV, capture_output=True, text=True
        )
        if result.returncode not in (0, 1):
            raise SandboxError(f"specs {' '.join(args)}: {result.stderr.strip()}")
        return result.stdout

    def write(self, rel: str, text: str) -> None:
        path = self.root / rel
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(text, encoding="utf-8")

    def read(self, rel: str) -> str:
        return (self.root / rel).read_text(encoding="utf-8")

    def replace(self, rel: str, old: str, new: str) -> None:
        text = self.read(rel)
        if text.count(old) != 1:
            raise SandboxError(f"{rel}: expected exactly one {old!r}")
        self.write(rel, text.replace(old, new))

    def commit(self, message: str) -> None:
        self.git("add", "-A")
        self.git("commit", "-q", "-m", message)

    def switch(self, branch: str, create: bool = False) -> None:
        self.git("switch", "-q", *(["-c"] if create else []), branch)

    def new_spec(self, title: str, slug: str, intent_text: str) -> str:
        """Create an intent spec through the helper, the way /sdlc:start does."""
        source = self.root / ".sandbox-intent.md"
        source.write_text(intent_text, encoding="utf-8")
        try:
            self.specs("new", "--date", DATE, "--title", title, "--slug", slug, "--intent-file", str(source))
        finally:
            source.unlink()
        return f"{DATE}-{slug}"


def build(target: Path, scenario: str | None) -> None:
    if target.exists() and any(target.iterdir()):
        raise SandboxError(f"{target} is not empty")
    if scenario and not (SCENARIOS / scenario / "steps.py").is_file():
        known = ", ".join(sorted(p.name for p in SCENARIOS.iterdir() if p.is_dir()))
        raise SandboxError(f"unknown scenario {scenario!r}; known: {known}")
    origin = target.parent / f"{target.name}.origin.git"
    if origin.exists():
        raise SandboxError(f"{origin} already exists")

    shutil.copytree(APP, target, dirs_exist_ok=True)
    sb = Sandbox(target)
    sb.git("init", "-q", "-b", "main")
    sb.specs("init", "--tracker", "github", "--host", "github")
    sb.commit("Initial commit: the webhooks app, set up for sdlc")
    subprocess.run(["git", "init", "-q", "--bare", "-b", "main", str(origin)], env=GIT_ENV, check=True)
    sb.git("remote", "add", "origin", str(origin))
    sb.git("push", "-q", "-u", "origin", "main")
    if scenario:
        runpy.run_path(str(SCENARIOS / scenario / "steps.py"))["apply"](sb)


def mutate(target: Path, step: str, args: list[str]) -> None:
    sb = Sandbox(target)
    if step == "edit-intent":
        intents = sorted((target / "specs").glob("*/intent.md")) or [target / "intent.md"]
        path = intents[0]
        if not path.is_file():
            raise SandboxError("no intent.md to edit")
        path.write_text(path.read_text(encoding="utf-8") + "\nAdded by the sandbox: one more requirement.\n")
    elif step == "commit":
        sb.commit(args[0] if args else "Sandbox change")
    elif step == "new-branch":
        if not args:
            raise SandboxError("new-branch needs a branch name")
        sb.switch(args[0], create=True)
    else:
        raise SandboxError(f"unknown step {step!r}; known: edit-intent, commit, new-branch")


def main(argv: list[str]) -> int:
    try:
        if argv and argv[0] == "mutate":
            parser = argparse.ArgumentParser(prog="sdlc-sandbox mutate")
            parser.add_argument("dir", type=Path)
            parser.add_argument("step")
            parser.add_argument("args", nargs="*")
            ns = parser.parse_args(argv[1:])
            mutate(ns.dir.resolve(), ns.step, ns.args)
        else:
            parser = argparse.ArgumentParser(prog="sdlc-sandbox", description=__doc__.split("\n\n")[0])
            parser.add_argument("dir", type=Path)
            parser.add_argument("--scenario")
            ns = parser.parse_args(argv)
            build(ns.dir.resolve(), ns.scenario)
            print(ns.dir)
    except SandboxError as exc:
        print(f"sdlc-sandbox: {exc}", file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
